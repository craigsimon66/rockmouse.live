{
  "name": "rockmouse-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://rockmouse.live",
    "DEFAULT_MODEL": "claude-sonnet-4-6",
    "MAX_TOKENS": "1024"
  },
  "d1_databases": [
    {
      "binding": "rockmouse_logins",
      "database_name": "rockmouse-logins",
      "database_id": "c0c852ba-029f-4f23-bde3-342c8773d6b6"
    }
  ],
  "triggers": {
    "crons": [
      "0 21 * * *"
    ]
  }
}
